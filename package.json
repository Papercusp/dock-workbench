{
  "name": "@papercusp/dock-workbench",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Host-agnostic dockview workbench shell: panel registry, logical layout schema, adapters, pluggable persistence, and React DockWorkspace.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Papercusp/dock-workbench.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "dockview": "^5 || ^6",
    "dockview-react": "^5 || ^6",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "@testing-library/react": "^16.0.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
